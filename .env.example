# Frontend / Convex project selection (written by `npx convex dev`)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# The matching .convex.site origin; also used to show the MCP server URL. Set both on Vercel too.
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public origin of the app (no trailing slash). Enables canonical/og:url links and sitemap.xml.
# VITE_SITE_URL=https://your-app.example
CONVEX_DEPLOYMENT=dev:your-deployment

# Configure these on the Convex deployment, never as VITE_ variables.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=
# AUTH_EMAIL=Common <hello@your-verified-domain.com>
# AUTH_REPLY_TO=you@example.com   (optional; any address, replies go here)
# SITE_URL=https://your-app.example   (also where agents approve connections)
# MCP_ALLOWED_ORIGINS=https://other-allowed-origin.example   (optional, comma-separated browser origins for /mcp)
# JWT_PRIVATE_KEY=generated by scripts/configure-auth.mjs
# JWKS=generated by scripts/configure-auth.mjs
